# AgentForge 环境变量配置
# 复制此文件为 .env 并填入真实值（.env 文件不提交 Git）

# LLM 模式：true=离线Mock(默认) false=真实API
LLM_MOCK_MODE=true

# ── API 密钥（config.yaml 中的 ${...} 占位符从这里展开）──
LLM_API_KEY=sk-your-deepseek-key-here
BAIDU_API_KEY=bce-v3/your-baidu-key-here
DASHSCOPE_API_KEY=sk-your-dashscope-key-here

# ── LLM 配置 ──
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# ── Worker 服务地址（本地开发用 localhost，Docker-Compose 部署时改为容器名）──
WORKER_ANALYST_URL=http://localhost:8001
WORKER_DESENSITIZE_URL=http://localhost:8002
WORKER_REPORT_URL=http://localhost:8003

# ── Docker-Compose 部署（可选）──
# REDIS_URL=redis://redis:6379
# SUPERVISOR_SECRET_KEY=change-this-to-random-string

# ── 演示数据路径 ──
# DEMO_CONTRACTS_DIR=/app/data/demo/contracts
# DEMO_RULES_PATH=/app/data/demo/audit_rules.json
# DEMO_SEED_MEMORY=/app/data/demo/seed_memory.json
