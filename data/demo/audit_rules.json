{
  "version": "1.0",
  "name": "企业内控合规审计规则库",
  "description": "用于企业合同与流程合规性自动审查的规则集合",
  "rules": [
    {
      "id": "RULE-001",
      "name": "大额合同二级审批",
      "severity": "P0",
      "description": "合同金额超过¥1,000,000需触发二级审批流程",
      "scope": ["销售合同", "采购协议", "技术服务合同"],
      "condition": {
        "field": "amount",
        "operator": ">",
        "value": 1000000
      },
      "action": "trigger_approval",
      "approval_level": 2,
      "approver_roles": ["财务总监", "法务总监"]
    },
    {
      "id": "RULE-002",
      "name": "身份证号脱敏要求",
      "severity": "P0",
      "description": "合同中出现的身份证号码必须脱敏，仅保留前3后4位",
      "scope": ["all"],
      "condition": {
        "field": "content",
        "regex": "(?<![0-9])[1-9]\\d{5}(19|20)\\d{2}(0[1-9]|1[0-2])(0[1-9]|[12]\\d|3[01])\\d{3}[\\dXx](?![0-9])"
      },
      "action": "desensitize",
      "mask_pattern": "{prefix}********{suffix}",
      "mask_prefix_length": 3,
      "mask_suffix_length": 4
    },
    {
      "id": "RULE-003",
      "name": "合同有效期上限",
      "severity": "P1",
      "description": "合同自签订之日起有效期超过3年需法务复核",
      "scope": ["销售合同", "采购协议"],
      "condition": {
        "field": "validity_years",
        "operator": ">",
        "value": 3
      },
      "action": "flag_for_review",
      "reviewer_role": "法务部"
    },
    {
      "id": "RULE-004",
      "name": "签约日期校验",
      "severity": "P1",
      "description": "签约日期不应早于乙方的营业执照注册日期",
      "scope": ["all"],
      "condition": {
        "field": "sign_date_vs_reg_date",
        "operator": "before"
      },
      "action": "flag_for_review",
      "reviewer_role": "合规部"
    },
    {
      "id": "RULE-005",
      "name": "手机号脱敏要求",
      "severity": "P1",
      "description": "合同中出现的手机号码必须脱敏，仅保留前3后4位",
      "scope": ["all"],
      "condition": {
        "field": "content",
        "regex": "1[3-9]\\d{9}"
      },
      "action": "desensitize",
      "mask_pattern": "{prefix}****{suffix}",
      "mask_prefix_length": 3,
      "mask_suffix_length": 4
    },
    {
      "id": "RULE-006",
      "name": "银行账号脱敏要求",
      "severity": "P1",
      "description": "合同中的银行账号必须脱敏",
      "scope": ["所有含支付条款的合同"],
      "condition": {
        "field": "content",
        "regex": "\\d{16,19}"
      },
      "action": "desensitize",
      "mask_pattern": "{prefix}********{suffix}",
      "mask_prefix_length": 4,
      "mask_suffix_length": 4
    },
    {
      "id": "RULE-007",
      "name": "违约金比例上限",
      "severity": "P2",
      "description": "约定的违约金比例不应超过合同金额的20%（民法典第585条参考）",
      "scope": ["all"],
      "condition": {
        "field": "penalty_percentage",
        "operator": ">",
        "value": 20
      },
      "action": "flag_for_review"
    }
  ]
}
